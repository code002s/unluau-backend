[package]
name = "unluac-server"
version = "0.1.0"
edition = "2021"

[dependencies]
unluac = { path = "./unluac-rs" }
axum = "0.6"
tokio = { version = "1.0", features = ["full"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
base64 = "0.21"
tower-http = { version = "0.4", features = ["cors"] }
